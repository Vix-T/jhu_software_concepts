# Module 6 settings. Copy to module_6/.env (git-ignored) and uncomment what you change.
# Docker Compose reads this file automatically; every setting below already has the
# default shown, so the stack runs with no .env at all. The defaults are
# development-only credentials: the database is not published outside the compose network.

# PostgreSQL owner (the worker connects as this user)
# POSTGRES_USER=gradcafe
# POSTGRES_PASSWORD=gradcafe_dev_only
# POSTGRES_DB=gradcafe

# Read-only role the worker creates at startup and the web service connects as
# WEB_DB_USER=gradcafe_web
# WEB_DB_PASSWORD=gradcafe_web_dev_only

# RabbitMQ account used by the web service and the worker
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest

# Chrome remote-debugging session on the host, for Pull Data (host:port)
# CHROME_DEBUGGER_ADDRESS=host.docker.internal:9222

# Build argument: chromedriver version baked into the worker image; must match the
# major version of the host's Chrome (https://googlechromelabs.github.io/chrome-for-testing/)
# CHROMEDRIVER_VERSION=154.0.8037.92

# Docker Hub namespace of the image tags (vixbot/module_6:web-v1, worker-v1)
# DOCKERHUB_USER=vixbot

# Tests only (pytest on the host, not Docker): a local PostgreSQL database whose name
# ends in _test. tests/conftest.py reads it from the environment or from module_6/.env.
TEST_DATABASE_URL=postgresql://your_username@localhost:5432/jhu_module6_test
