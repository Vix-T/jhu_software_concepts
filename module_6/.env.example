# PostgreSQL server host
DB_HOST=localhost
# PostgreSQL port (optional, defaults to 5432)
DB_PORT=5432
# Module 6 development database (tests never use it)
DB_NAME=jhu_module6
# PostgreSQL user name
DB_USER=your_username
# Password; leave empty for local trust authentication
DB_PASSWORD=
# Test database for pytest; its name must end in _test
TEST_DATABASE_URL=postgresql://your_username@localhost:5432/jhu_module6_test
# Optional: set to 1 to run the Flask debugger/reloader (never in production; default off)
# FLASK_DEBUG=1
# Least-privilege role the app connects as; created by `python src/setup_roles.py` run as the owner
APP_DB_USER=gradcafe_app
# Its password (setup_roles.py sets it; then put these two values in DB_USER / DB_PASSWORD)
APP_DB_PASSWORD=change_me
